        { "kind": "split", "id": 4, "dir": "column", "sizes": [0.6, 0.4],
          "children": [
            { "kind": "pane", "id": 2, "tabs": [{ "path": "B.md", "mode": "reading" }], "active": 0 },
            { "kind": "pane", "id": 5, "tabs": [{ "path": "A.md", "mode": "source" }], "active": 0 }
          ] }
